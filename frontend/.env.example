# ─────────────────────────────────────────────
#  WorkSync Frontend — Environment Variables
#  Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# ── API Base URL ──────────────────────────────
# Leave EMPTY for local development (Vite proxy handles /api/* → localhost:8000)
# Set to your backend's deployed URL for production builds:
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=
